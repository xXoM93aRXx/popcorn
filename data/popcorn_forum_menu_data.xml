<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Created as a child of the main menu so it shows in the site nav and
             is picked up by the sticky footer, which lists every visible child
             menu. noupdate keeps any rename, reorder or removal made in the
             website editor from being undone by a module upgrade. -->
        <record id="menu_popcorn_forum_website" model="website.menu">
            <field name="name">Club Forum</field>
            <field name="url">/forum</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">45</field>
            <field name="fa_icon">fa-comments</field>
        </record>

    </data>
</odoo>
